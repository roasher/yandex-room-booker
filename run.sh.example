#!/usr/bin/env bash
set -euo pipefail

# Booking modes (ROOM_BOOKER_BOOKING_MODE):
#   api     — Public Calendar API; needs YANDEX_CALENDAR_OAUTH_TOKEN
#   browser — Web UI API; needs YANDEX_CALENDAR_COOKIES (full Cookie header, like EVENTS_API_COOKIES)
#             ckey/uid are fetched automatically. Prefer for debugging detailed errors.
#
# Rooms: see src/main/resources/rooms.yml
# Duration: 90m, 1h, 1h30m

export ROOM_BOOKER_BOOKING_MODE="browser"
export YANDEX_CALENDAR_COOKIES="gdpr=0; Session_id=...; sessionid2=...; ..."

# For api mode instead:
# export ROOM_BOOKER_BOOKING_MODE="api"
# export YANDEX_CALENDAR_OAUTH_TOKEN="y1_..."

export SPRING_APPLICATION_JSON="$(cat <<EOF
{
  "room-booker": {
    "enabled": true,
    "meeting-name": "D",
    "room": "stroganov-yoga",
    "start": "2026-06-22T14:00:00",
    "duration": "1h30m"
  }
}
EOF
)"

mkdir -p logs
RUN_LOG="logs/run-$(date +%Y%m%d-%H%M%S).log"
ln -sfn "$(basename "$RUN_LOG")" logs/latest.log
echo "Writing run log to ${RUN_LOG} (also logs/latest.log)"
./mvnw spring-boot:run 2>&1 | tee "$RUN_LOG"
