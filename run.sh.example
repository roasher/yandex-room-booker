#!/usr/bin/env bash
set -euo pipefail

# Booking modes (ROOM_BOOKER_BOOKING_MODE):
#   api     — Public Calendar API; needs YANDEX_CALENDAR_OAUTH_TOKEN.
#             Its room catalogue excludes yandex-team accounts, even with the required scopes.
#   browser — Web UI API; needs YANDEX_CALENDAR_COOKIES (full Cookie header, like EVENTS_API_COOKIES)
#             ckey/uid are fetched automatically. Use for corporate room availability checks.
#
# Each room-booker entry has one room and its own slots. See src/main/resources/rooms.yml.
# enabled and meeting-name are set independently for every entry.
# Duration: 90m, 1h, 1h30m
# Date: ISO date ("2026-12-03"). Replace the example dates/times below with your desired bookings.
# Day-of-week: integer (1 = Monday, ..., 7 = Sunday), as an alternative to date.
# At least one is required. If both are set, the date must fall on the specified day-of-week.
# Without date, day-of-week selects its next occurrence after today, in room-booker-settings.time-zone.
# Time: HH:mm or HH:mm:ss, e.g. "14:00".
# All dates/times use room-booker-settings.time-zone (Europe/Moscow by default), regardless of computer time zone.
# Every entry in slots is booked independently; a failure does not stop the other slots.
# Duration is shared unless an entry overrides it. Slots must not overlap.
# Date/day-of-week/time belong inside slots, even when there is only one slot.
# Lines starting with # (after optional whitespace) are ignored inside the configuration block.

export ROOM_BOOKER_BOOKING_MODE="browser"
export YANDEX_CALENDAR_COOKIES="gdpr=0; Session_id=...; sessionid2=...; ..."

# For api mode instead:
# export ROOM_BOOKER_BOOKING_MODE="api"
# export YANDEX_CALENDAR_OAUTH_TOKEN="y1_..."

export SPRING_APPLICATION_JSON="$(sed '/^[[:space:]]*#/d' <<EOF
{
  "room-booker-settings": {
    "time-zone": "Europe/Moscow"
  },
  "room-booker": [
    {
      "enabled": true,
      "meeting-name": "Yoga",
      "room": "stroganov-yoga",
      "duration": "1h30m",
      "slots": [
#        Exact date: 1 December 2026 at 14:00 Moscow time.
        {
          "date": "2026-12-01",
          "time": "14:00"
        },
#        Weekday: next Monday after today at 14:00 Moscow time.
        {
          "day-of-week": 1,
          "time": "14:00",
          "duration": "1h"
        }
      ]
    },
    {
      "enabled": true,
      "meeting-name": "Music",
      "room": "lotte-music",
      "duration": "1h",
      "slots": [
        {
          "date": "2026-12-04",
          "time": "18:30"
        }
      ]
    }
  ]
}
EOF
)"

mkdir -p logs
RUN_LOG="logs/run-$(date +%Y%m%d-%H%M%S).log"
ln -sfn "$(basename "$RUN_LOG")" logs/latest.log
echo "Writing run log to ${RUN_LOG} (also logs/latest.log)"
./mvnw spring-boot:run 2>&1 | tee "$RUN_LOG"
